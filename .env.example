# Copy to .env and fill real values. .env is gitignored — never commit secrets.

# Postgres (relational rows + pgvector embeddings)
POSTGRES_USER=accel
POSTGRES_PASSWORD=accel_local_pw
POSTGRES_DB=accelerator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MinIO (S3-compatible object storage for original files)
MINIO_ROOT_USER=accel
MINIO_ROOT_PASSWORD=accel_local_pw
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=documents

# External APIs — real keys ONLY in local .env, never committed
VISION_API_KEY=
LLM_API_KEY=
