# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.
#
# Minimum to get started locally:
#   1. Set GROQ_API_KEY (free tier at console.groq.com)
#   2. Set GOOGLE_API_KEY (free tier at aistudio.google.com)
#   3. Run: docker compose up -d
#   4. The POSTGRES_URL and QDRANT_URL defaults match docker-compose.yml

# ── LLM ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here   # only if using openai provider

# ── Vision (Gemma) ────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_ai_studio_key_here   # aistudio.google.com → Get API key
# Not needed if using vision.provider: ollama in config

# ── Observability (Langfuse) ──────────────────────────────────────────────────
# For local Langfuse (docker-compose), create a project at http://localhost:3001
# then copy the keys here.
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=http://localhost:3001

# ── Databases ─────────────────────────────────────────────────────────────────
# Default values match docker-compose.yml — change only for non-Docker setups.
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/accelerator
QDRANT_URL=http://localhost:6333
