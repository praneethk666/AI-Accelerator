# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.
#
# Minimum to get started locally:
#   1. Set ZAI_API_KEY (free tier at z.ai — GLM-4.7-Flash text + GLM-4.6V-Flash
#      vision) — covers LLM + vision + the agent's tool-calling model, all one key.
#   2. Run: docker compose up -d
#   3. The POSTGRES_URL and QDRANT_URL defaults match docker-compose.yml

# ── LLM + Vision (config: llm / vision / vision_ocr / query.agent) ────────────
# ACTIVE default (21-Jul): z.ai GLM, free tier. ONE key covers text + vision + agent.
ZAI_API_KEY=your_zai_api_key_here
# Alternatives (swap the matching config block's provider/model/base_url):
# Groq (free, ~100k tokens/day per model):
# GROQ_API_KEY=your_groq_api_key_here
# Gemini 2.5 Flash on Google AI Studio (paid — used until 21-Jul):
# GOOGLE_API_KEY=your_google_ai_studio_key_here   # aistudio.google.com → Get API key
# DeepSeek (cheap paid, ~$0.87/M output — fallback if the z.ai free tier is too rate-limited):
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OpenAI (no rate-limit caps, ~$0.15/1M tokens in):
# OPENAI_API_KEY=your_openai_api_key_here
# Anthropic Claude — strong structured-JSON extraction (provider: anthropic):
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Any other OpenAI-compatible endpoint (NVIDIA Build API, a self-hosted vLLM box,
# OpenRouter, ...) — point the config block's base_url at it and set the matching key:
# NVIDIA_API_KEY=your_nvidia_build_api_key_here
# VLLM_API_KEY=your_self_hosted_vllm_bearer_token_here
JINA_API_KEY=your_jina_api_key_here
# Self-hosted Unlimited-OCR rescue engine (vision_ocr.engine: local) — shared secret
# between scripts/unlimited_ocr_server.py's env and vision_ocr.local_api_key:
# UNLIMITED_OCR_API_KEY=your_shared_secret_here

# ── Agent tools ───────────────────────────────────────────────────────────────
# Read-only DB connector (backend/connectors/sql_read.py). Falls back to
# POSTGRES_URL below if unset.
# SQL_READONLY_URL=postgresql://readonly_user:pw@host:5432/yourdb

# ── Observability (Langfuse) ──────────────────────────────────────────────────
# For local Langfuse (docker-compose), create a project at http://localhost:3001
# then copy the keys here.
# LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
# LANGFUSE_SECRET_KEY=your_langfuse_secret_key
# LANGFUSE_HOST=http://localhost:3001

OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic%20<your-base64-token>="
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=ai-accelerator

# ── Databases ─────────────────────────────────────────────────────────────────
# Default values match docker-compose.yml — change only for non-Docker setups.
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/accelerator
QDRANT_URL=http://localhost:6333
# Set only if using Qdrant Cloud (leave blank/unset for local Docker setup)
# QDRANT_API_KEY=your_qdrant_cloud_api_key_here
