# ==============================================================================
# AI-ACCELERATOR ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
#   1. Copy this file to '.env' (which is gitignored):
#      cp .env.example .env
#   2. Fill in the MANDATORY keys and any OPTIONAL/CONDITIONAL keys you require.
#   3. Variables defined here are automatically substituted into config/global.yaml
#      wherever '${VARIABLE_NAME}' is referenced.
#
# Summary of Requirements:
#   - [MANDATORY] Database & Vector Store (POSTGRES_URL, QDRANT_URL)
#   - [MANDATORY] At least ONE LLM API key matching your provider in config/global.yaml
#   - [CONDITIONAL] Storage / Docling / Reranker keys depending on your chosen config
#   - [OPTIONAL] Telemetry & Monitoring (Langfuse, OpenTelemetry)
# ==============================================================================


# ── 1. LLM & Reasoning Providers ─────────────────────────────────────────────
# [MANDATORY]: You must provide at least ONE API key corresponding to the active
# provider configured in config/global.yaml (under 'llm:', 'query.agent:', etc.).

# [MANDATORY if provider is 'openai']
# Required if using GPT-4o, GPT-4o-mini, or text-embedding-3-* models.
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# [OPTIONAL / ALTERNATIVE PROVIDER]
# Z.AI: Free tier covering text (GLM-4.7-Flash) + vision (GLM-4.6V-Flash) + agent.
# Get key: https://z.ai
ZAI_API_KEY=your_zai_api_key_here

# [OPTIONAL / ALTERNATIVE PROVIDER]
# Groq: Required if using Groq for ultra-fast Llama-3 / Mixtral inference.
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# [OPTIONAL / ALTERNATIVE PROVIDER]
# Google AI Studio: Required if using Gemini 2.0 / 2.5 Flash models.
# Get key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here

# [OPTIONAL / ALTERNATIVE PROVIDER]
# DeepSeek: Required if using DeepSeek-V3 or DeepSeek-R1 reasoning models.
# Get key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# [OPTIONAL / ALTERNATIVE PROVIDER]
# Anthropic: Required if using Claude 3.5 Sonnet / Claude 3 Opus.
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# [OPTIONAL / ALTERNATIVE PROVIDER]
# NVIDIA NIM: Required if using NVIDIA hosted open models (e.g. Llama-3.2-11B-Vision).
# Get key: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_build_api_key_here

# [CONDITIONAL - Required if using hosted Jina Reranker / Embeddings]
# Jina AI: Required when embeddings.reranker_provider is set to 'jina' in config/global.yaml.
# Get key: https://jina.ai/embeddings
JINA_API_KEY=your_jina_api_key_here


# ── 2. Cloud Storage & Document Persistence ──────────────────────────────────
# [CONDITIONAL]: Required if storage.provider is set to 'supabase' in config/global.yaml.
# Used for persistent cloud storage of uploaded PDFs, DOCX, images, and converted assets.

# [CONDITIONAL - MANDATORY for Supabase Storage]
# Supabase Project URL (e.g., https://your-project-id.supabase.co)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://<your-project-id>.supabase.co

# [CONDITIONAL - MANDATORY for Supabase Storage]
# Supabase API Key (use service_role secret key for backend)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys
SUPABASE_KEY=your_supabase_service_or_anon_key

# [CONDITIONAL - MANDATORY for Supabase Storage]
# Supabase Storage Bucket name (default: documents)
SUPABASE_BUCKET=documents

# [OPTIONAL]: Local MinIO / S3-compatible object store (only if using MinIO provider)
# MINIO_ENDPOINT=localhost:9000
# MINIO_BUCKET=documents
# MINIO_ROOT_USER=accel
# MINIO_ROOT_PASSWORD=accel_local_pw


# ── 3. Remote Document Extraction (Docling Server) ───────────────────────────
# [CONDITIONAL]: Required ONLY if extraction.docling.mode is set to 'server'.
# Offloads heavy PDF parsing, OCR, and table extraction to a remote server.

# [CONDITIONAL - MANDATORY if using Remote Docling Server]
# Base URL of the remote Docling microservice (e.g. http://100.49.250.232:8083 or http://localhost:8083)
DOCLING_SERVER_URL=http://localhost:8083

# [OPTIONAL]
# API Key / Bearer token if the remote Docling server requires authentication
DOCLING_API_KEY=your_docling_api_key_here


# ── 4. Databases & Vector Search ─────────────────────────────────────────────
# [MANDATORY]: Required for document metadata, chunks, and vector search.
# Defaults match docker-compose.yml for immediate local execution.

# [MANDATORY]
# PostgreSQL connection string (metadata, chunk records, chat sessions)
# Default for local Docker: postgresql://postgres:postgres@localhost:5432/accelerator
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/accelerator

# [MANDATORY]
# Qdrant Vector Database endpoint (stores dense and sparse vector embeddings)
# Default for local Docker: http://localhost:6333
QDRANT_URL=http://localhost:6333

# [CONDITIONAL - MANDATORY only if using managed Qdrant Cloud]
# Leave commented out / empty when using local Docker
# QDRANT_API_KEY=your_qdrant_cloud_api_key_here


# ── 5. Agent Tools & External Connectors ──────────────────────────────────────
# [OPTIONAL]: Read-only database connection for the agent's SQL query tool (sql_read).
# If unset/commented out, the agent defaults to using POSTGRES_URL above.
# SQL_READONLY_URL=postgresql://readonly_user:password@host:5432/production_db


# ── 6. Observability, Telemetry & Tracing ─────────────────────────────────────
# [OPTIONAL]: Distributed tracing, token usage, and latency metrics.

# [OPTIONAL]: Langfuse LLM tracing & prompt management
# LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
# LANGFUSE_SECRET_KEY=your_langfuse_secret_key
# LANGFUSE_HOST=http://localhost:3001

# [OPTIONAL]: OpenTelemetry / Grafana Cloud tracing
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic%20<your-base64-token>="
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=ai-accelerator
OTEL_BSP_SCHEDULE_DELAY=1000
